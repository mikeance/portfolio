---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { works } from '../lib/works';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<Base lang={lang} path="/works" image={works[0]?.strip[0]} title={t('seo.works.title')} description={t('seo.works.description')} h1={`${t('seo.works.title')} — Miguel Antón`}>
  <main class="wrap">
    <WorkList items={works.map((w) => ({ name: w.name, href: w.href, photos: w.strip }))} />
  </main>
</Base>
