---
import Base from '../layouts/Base.astro';
import Scatter from '../components/Scatter.astro';
import { localePath, useTranslations, type Lang } from '../i18n/ui';
import { works } from '../lib/works';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<Base lang={lang} path="/works" title={t('nav.works')}>
  <main class="wrap">
    <ul class="list">
      {works.map((w) => (
        <li>
          <a class="work" href={localePath(lang, `/works/${w.slug}`)}><Scatter text={w.name} /></a>
          {/* Al pasar el cursor: fila horizontal (con scroll) de las fotos del trabajo */}
          <div class="strip" aria-hidden="true">
            {w.photos.map((p) => <img src={`/photos/${p.id}-800.webp`} alt="" loading="lazy" decoding="async" style={`aspect-ratio:${p.ratio}`} />)}
          </div>
        </li>
      ))}
    </ul>
  </main>
</Base>
<style>
  .list { list-style: none; margin: 1rem 0 0; padding: 0; }
  li { padding: 0.35rem 0; }
  .work { display: inline-block; font-size: clamp(1.4rem, 3.2vw, 2.4rem); font-weight: 400; letter-spacing: 0.02em; text-transform: uppercase; color: var(--muted); line-height: 1.3; padding: 0.15em 0; }
  .work:hover, li.on .work { color: var(--fg); }
  .strip { display: none; gap: 10px; overflow-x: auto; overflow-y: hidden; padding: 0.4rem 0 0.9rem; margin-top: 0.1rem; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
  .strip img { display: block; height: 150px; width: auto; flex: 0 0 auto; box-sizing: border-box; padding: 6px; background: var(--mat); }
  li:hover .strip, li.on .strip { display: flex; }
  @media (hover: none) { li:hover .strip { display: none; } li.on .strip { display: flex; } }
</style>
<script>
  // En táctil: el primer toque descoloca las letras y muestra la fila de fotos; el segundo abre el trabajo.
  document.querySelectorAll<HTMLLIElement>('.list li').forEach((li) => {
    const a = li.querySelector('a')!;
    a.addEventListener('touchend', (e) => {
      if (li.classList.contains('on')) return;
      e.preventDefault();
      document.querySelectorAll('.list li.on').forEach((o) => o.classList.remove('on'));
      li.classList.add('on');
    }, { passive: false });
  });
</script>
