---
import Base from '../layouts/Base.astro';
import Mosaic from '../components/Mosaic.astro';
import Lightbox from '../components/Lightbox.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Photo } from '../lib/photos';
interface Props { lang: Lang; path: string; title?: string; photos: Photo[]; order?: 'color' | 'manual' }
const { lang, path, title, photos, order } = Astro.props;
const t = useTranslations(lang);
---
<Base lang={lang} path={path} title={title}>
  <main class="wrap">
    <Mosaic photos={photos} order={order} />
  </main>
  <Lightbox closeLabel={t('lightbox.close')} />
</Base>
