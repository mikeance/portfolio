---
/** Mosaico de una colección dentro de un work (fotos/works/<NN WORK>/<NN COLECCIÓN>/). */
import Base from '../layouts/Base.astro';
import Mosaic from '../components/Mosaic.astro';
import Lightbox from '../components/Lightbox.astro';
import Scatter from '../components/Scatter.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Work, Section } from '../lib/works';
const { lang, work, section } = Astro.props as { lang: Lang; work: Work; section: Section };
const t = useTranslations(lang);
---
<Base lang={lang} path={section.href} title={`${section.name} · ${work.name}`}>
  <main class="wrap">
    <a class="up" href={work.href}>{work.name}</a>
    <h1><Scatter text={section.name} class="now" /></h1>
    <Mosaic photos={section.photos} order="manual" />
  </main>
  <Lightbox closeLabel={t('lightbox.close')} />
</Base>
<style>
  .up { display: inline-block; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 0.6rem; }
  .up:hover { color: var(--fg); }
  h1 { font-size: clamp(1.2rem, 2.4vw, 1.8rem); font-weight: 400; letter-spacing: 0.02em; text-transform: uppercase; margin: 0.2rem 0 1.6rem; }
</style>
