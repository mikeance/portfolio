---
/** Página de un work: si tiene colecciones (subcarpetas), lista desplegable como /works; si no, mosaico. */
import Base from '../layouts/Base.astro';
import Mosaic from '../components/Mosaic.astro';
import Lightbox from '../components/Lightbox.astro';
import Scatter from '../components/Scatter.astro';
import WorkList from '../components/WorkList.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { seoName, type Work } from '../lib/works';
const { lang, work } = Astro.props as { lang: Lang; work: Work };
const t = useTranslations(lang);
const asList = work.sections.length > 0;
---
<Base lang={lang} path={work.href} image={work.strip[0]} title={seoName(work.name)} description={t('seo.work.description').replaceAll('{name}', seoName(work.name))}>
  <main class="wrap">
    <h1><Scatter text={work.name} class="now" /></h1>
    {asList ? <WorkList items={work.sections.map((s) => ({ name: s.name, href: s.href, photos: s.strip }))} /> : <Mosaic photos={work.photos} order="manual" />}
  </main>
  {!asList && <Lightbox closeLabel={t('lightbox.close')} />}
</Base>
<style>
  h1 { font-size: clamp(1.2rem, 2.4vw, 1.8rem); font-weight: 400; letter-spacing: 0.02em; text-transform: uppercase; margin: 0.6rem 0 1.6rem; }
</style>
