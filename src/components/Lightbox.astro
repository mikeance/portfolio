---
interface Props { closeLabel: string }
const { closeLabel } = Astro.props;
---
<div id="lightbox" hidden>
  <button type="button" id="lb-close" aria-label={closeLabel}>×</button>
  <div id="lb-track"></div>
  <button type="button" id="lb-prev" aria-label="Previous">‹</button>
  <button type="button" id="lb-next" aria-label="Next">›</button>
  <p></p>
</div>
<style>
  #lightbox { position: fixed; inset: 0; background: rgba(255, 255, 255, 0.97); display: grid; place-items: center; z-index: 50; cursor: zoom-out; }
  #lightbox[hidden] { display: none; }
  /* Carrusel: una tira horizontal con "imán" en cada foto; en móvil se desliza con el dedo con inercia nativa */
  #lb-track { position: absolute; inset: 0; display: flex; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  #lb-track::-webkit-scrollbar { display: none; }
  #lb-track :global(.slide) { flex: 0 0 100%; width: 100%; height: 100%; scroll-snap-align: center; scroll-snap-stop: always; display: grid; place-items: center; }
  #lb-track :global(img) { max-width: 86vw; max-height: 88vh; object-fit: contain; cursor: pointer; }
  #lb-prev[hidden], #lb-next[hidden] { display: none; }
  /* Flechas en los laterales, centradas en vertical */
  #lb-prev, #lb-next { all: unset; position: fixed; top: 0; bottom: 0; width: 6vw; min-width: 44px; display: flex; align-items: center; justify-content: center; font-size: 2.6rem; line-height: 1; cursor: pointer; color: var(--muted); }
  #lb-prev { left: 0; } #lb-next { right: 0; }
  #lb-prev:hover, #lb-next:hover { color: var(--fg); }
  @media (max-width: 560px) { #lb-prev, #lb-next { display: none; } #lb-track :global(img) { max-width: 94vw; } }
  #lightbox p { position: absolute; bottom: 0.9rem; pointer-events: none; left: 0; right: 0; margin: 0; text-align: center; font-size: 0.8rem; letter-spacing: 0.06em; color: var(--muted); }
  #lb-close { all: unset; position: absolute; top: 1rem; right: 1.5rem; font-size: 2.2rem; line-height: 1; cursor: pointer; color: var(--muted); z-index: 2; }
</style>
