---
import type { Photo } from '../lib/photos';
import { sortByColor, sortLife, sortFaces } from '../lib/photos';
interface Props { photos: Photo[]; order?: 'color' | 'manual' | 'life' | 'faces' }
const { photos, order = 'color' } = Astro.props;
const items = order === 'manual' ? photos : order === 'life' ? sortLife(photos) : order === 'faces' ? sortFaces(photos) : sortByColor(photos);
---
<div class="grid">
  {items.map((p) => (
    <figure class={p.ratio > 1.15 ? 'wide' : undefined} data-id={p.id} data-r={p.ratio} data-title={p.title}>
      <img src={`/photos/${p.id}-800.webp`} alt={p.title ?? ''} loading="lazy" decoding="async" width="800" height={Math.round(800 / p.ratio)} />
      {p.title && <figcaption class={(p.lumB ?? p.lum) < 0.45 ? 'light' : undefined}>{p.title}</figcaption>}
    </figure>
  ))}
</div>

<style>
  /* Mosaico compacto (JS): cada foto conserva su proporción, las horizontales ocupan dos columnas y no quedan huecos. */
  .grid { position: relative; }
  figure { position: absolute; margin: 0; cursor: zoom-in; }
  figure img { display: block; width: 100%; height: auto; box-sizing: border-box; padding: 6px; background: var(--mat); opacity: 0; transition: opacity 0.5s; }
  figure img.ok { opacity: 1; }
  /* Texto de la foto: discreto, en gris, en la parte inferior; aparece al pasar el cursor */
  figcaption { position: absolute; left: 6px; right: 6px; bottom: 6px; padding: 0.45rem 0.6rem 1.1rem; font-size: 0.7rem; letter-spacing: 0.04em; text-align: center; color: rgba(15, 15, 15, 0.92); opacity: 0; transition: opacity 0.35s; pointer-events: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  figcaption.light { color: rgba(255, 255, 255, 0.96); }
  figure:hover figcaption { opacity: 1; }
  @media (hover: none) { figcaption { display: none; } }
</style>

<script>
  const GAP = 10, PAD = 12; // hueco entre fotos y marco (6px por lado)
  const colCount = () => (innerWidth >= 1500 ? 5 : innerWidth >= 900 ? 4 : innerWidth >= 560 ? 3 : 2);

  // Cada foto va a la columna más corta. Una horizontal ocupa dos columnas: se coloca cuando dos columnas
  // vecinas están casi a la misma altura y la diferencia se reparte entre los huecos de la más corta.
  function layout(grid: HTMLElement) {
    const figs = [...grid.querySelectorAll('figure')] as HTMLElement[];
    const cols = colCount();
    const col = (grid.clientWidth - (cols - 1) * GAP) / cols;
    const h = new Array(cols).fill(0);
    const stacks: { el: HTMLElement; top: number }[][] = Array.from({ length: cols }, () => []);
    const hgt = (el: HTMLElement, w: number) => (w - PAD) / +el.dataset.r! + PAD;
    const queue = figs.slice();
    const wides: { top: number; bottom: number; col: number }[] = []; // horizontales ya colocadas (franja vertical)
    const placeV = (el: HTMLElement, c: number) => {
      el.style.cssText = `left:${c * (col + GAP)}px;top:${h[c]}px;width:${col}px`;
      stacks[c].push({ el, top: h[c] });
      h[c] += hgt(el, col) + GAP;
    };
    const placeW = (el: HTMLElement, c: number) => {
      const short = h[c] <= h[c + 1] ? c : c + 1, d = Math.abs(h[c] - h[c + 1]), y = Math.max(h[c], h[c + 1]);
      const st = stacks[short];
      if (d > 0 && st.length) { const extra = d / st.length; st.forEach((s, i) => { s.top += extra * (i + 1); s.el.style.top = `${s.top}px`; }); }
      const w = 2 * col + GAP;
      el.style.cssText = `left:${c * (col + GAP)}px;top:${y}px;width:${w}px`;
      wides.push({ top: y, bottom: y + hgt(el, w), col: c });
      h[c] = h[c + 1] = y + hgt(el, w) + GAP;
      stacks[c] = []; stacks[c + 1] = [];
    };
    const bestPair = (c: number) => {
      let best = -1, bd = Infinity;
      for (const i of [c - 1, c]) if (i >= 0 && i + 1 < cols) { const d = Math.abs(h[i] - h[i + 1]); if (d < bd) { bd = d; best = i; } }
      return { i: best, d: bd };
    };
    while (queue.length) {
      const c = h.indexOf(Math.min(...h));
      const wi = queue.findIndex((el) => el.classList.contains('wide'));
      const vi = queue.findIndex((el) => !el.classList.contains('wide'));
      if (wi >= 0 && (vi < 0 || wi === 0)) {
        const { i, d } = bestPair(c);
        const short = h[i] <= h[i + 1] ? i : i + 1;
        const tolerable = d <= 14 * stacks[short].length + 1;
        const y = Math.max(h[i], h[i + 1]), hh = hgt(queue[wi], 2 * col + GAP);
        const alone = !wides.some((o) => y < o.bottom && y + hh > o.top); // ninguna otra horizontal a la misma altura
        if (i >= 0 && tolerable && alone) { placeW(queue.splice(wi, 1)[0], i); continue; }
        // solo quedan horizontales: se apilan bajo la última para no compartir franja
        if (vi < 0) { placeW(queue.splice(wi, 1)[0], alone && i >= 0 ? i : (wides.at(-1)?.col ?? 0)); continue; }
      }
      placeV(queue.splice(vi, 1)[0], c);
    }
    grid.style.height = `${Math.max(0, Math.max(...h) - GAP)}px`;
  }

  const grids = [...document.querySelectorAll<HTMLElement>('.grid')];
  const layoutAll = () => grids.forEach(layout);
  document.querySelectorAll<HTMLImageElement>('.grid img').forEach((img) => {
    const ok = () => img.classList.add('ok');
    img.complete ? ok() : img.addEventListener('load', ok);
  });
  layoutAll();
  addEventListener('resize', layoutAll);

  // Visor (uno por página, ver Lightbox.astro): carrusel con scroll horizontal (dedo en móvil; flechas, teclado
  // o clic en la mitad derecha/izquierda de la foto en escritorio). No da la vuelta al llegar al final.
  const lb = document.getElementById('lightbox');
  if (lb) {
    const track = document.getElementById('lb-track')!;
    const lbTitle = lb.querySelector('p')!;
    const prevBtn = document.getElementById('lb-prev')!, nextBtn = document.getElementById('lb-next')!;
    const all = [...document.querySelectorAll<HTMLElement>('.grid figure')];
    const touch = matchMedia('(hover: none)').matches;
    // una "diapositiva" por foto; la imagen se carga cuando está cerca
    const slides = all.map((fig) => {
      const d = document.createElement('div'); d.className = 'slide';
      const img = document.createElement('img'); img.alt = fig.dataset.title || ''; img.dataset.src = `/photos/${fig.dataset.id}-1600.webp`; img.draggable = false;
      d.appendChild(img); track.appendChild(d); return d;
    });
    let idx = -1;
    const load = (i: number) => { for (const k of [i - 1, i, i + 1]) { const img = slides[k]?.querySelector('img'); if (img && !img.src) img.src = img.dataset.src!; } };
    const sync = (i: number) => {
      idx = i; load(i);
      lbTitle.textContent = all[i].dataset.title || '';
      prevBtn.hidden = i === 0; nextBtn.hidden = i === all.length - 1;
    };
    const goTo = (i: number, smooth = true) => {
      if (i < 0 || i >= all.length) return;
      sync(i);
      track.scrollTo({ left: i * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };
    const open = (i: number) => { lb.hidden = false; goTo(i, false); };
    const closeLb = () => { lb.hidden = true; };
    // al deslizar, la foto activa es la que queda centrada
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => { const i = Math.round(track.scrollLeft / track.clientWidth); if (i !== idx && i >= 0 && i < all.length) sync(i); }); }, { passive: true });
    addEventListener('resize', () => { if (!lb.hidden && idx >= 0) track.scrollTo({ left: idx * track.clientWidth }); });
    document.addEventListener('click', (e) => {
      const fig = (e.target as HTMLElement).closest('.grid figure') as HTMLElement | null;
      if (fig) open(all.indexOf(fig));
    });
    lb.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.tagName === 'IMG') { if (touch) return; const r = t.getBoundingClientRect(); goTo(e.clientX - r.left > r.width / 2 ? idx + 1 : idx - 1); }
      else if (t.id === 'lb-next') goTo(idx + 1);
      else if (t.id === 'lb-prev') goTo(idx - 1);
      else closeLb();
    });
    addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') closeLb(); else if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); goTo(idx + 1); } else if (e.key === 'ArrowLeft') goTo(idx - 1);
    });
  }
</script>
