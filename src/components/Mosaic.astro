---
import type { Photo } from '../lib/photos';
import { sortByColor } from '../lib/photos';
interface Props { photos: Photo[]; closeLabel: string; order?: 'color' | 'manual' }
const { photos, closeLabel, order = 'color' } = Astro.props;
const items = order === 'manual' ? photos : sortByColor(photos);
---
<main>
  <div class="grid">
    {items.map((p) => (
      <figure class={p.ratio > 1.15 ? 'wide' : undefined} data-id={p.id}>
        <img src={`/photos/${p.id}-800.webp`} alt="" loading="lazy" decoding="async" width="800" height={Math.round(800 / p.ratio)} />
      </figure>
    ))}
  </div>
</main>
<div id="lightbox" hidden>
  <button type="button" id="lb-close" aria-label={closeLabel}>×</button>
  <img alt="" />
</div>

<style>
  main { padding: 0.5rem var(--gutter) 2rem; max-width: 1700px; margin: 0 auto; container-type: inline-size; }
  /* Rejilla: celdas verticales 2:3 con altura fija por fila; una horizontal ocupa dos columnas y la misma altura. */
  .grid { --cols: 4; --gap: 10px; display: grid; grid-template-columns: repeat(var(--cols), 1fr); grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols) * 1.5); grid-auto-flow: dense; gap: var(--gap); }
  figure { margin: 0; padding: 6px; background: var(--mat); cursor: zoom-in; min-height: 0; }
  figure.wide { grid-column: span 2; }
  figure img { display: block; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity 0.5s; }
  figure img.ok { opacity: 1; }
  @media (min-width: 1500px) { .grid { --cols: 5; } }
  @media (max-width: 899px) { .grid { --cols: 3; } }
  @media (max-width: 559px) { .grid { --cols: 2; } }
  #lightbox { position: fixed; inset: 0; background: rgba(255, 255, 255, 0.97); display: grid; place-items: center; z-index: 50; cursor: zoom-out; }
  #lightbox[hidden] { display: none; }
  #lightbox img { max-width: 92vw; max-height: 92vh; object-fit: contain; }
  #lb-close { all: unset; position: absolute; top: 1rem; right: 1.5rem; font-size: 2.2rem; line-height: 1; cursor: pointer; color: var(--muted); }
</style>

<script>
  const grid = document.querySelector('.grid')!;
  const lb = document.getElementById('lightbox')!;
  const lbImg = lb.querySelector('img')!;
  grid.querySelectorAll('img').forEach((img) => {
    const ok = () => img.classList.add('ok');
    img.complete ? ok() : img.addEventListener('load', ok);
  });
  grid.addEventListener('click', (e) => {
    const fig = (e.target as HTMLElement).closest('figure');
    if (!fig) return;
    lbImg.src = `/photos/${fig.dataset.id}-1600.webp`;
    lb.hidden = false;
  });
  const closeLb = () => { lb.hidden = true; lbImg.removeAttribute('src'); };
  lb.addEventListener('click', closeLb);
  addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });
</script>
