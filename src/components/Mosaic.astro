---
import type { Photo } from '../lib/photos';
import { sortByColor, sortLife, sortFaces } from '../lib/photos';
interface Props { photos: Photo[]; order?: 'color' | 'manual' | 'life' | 'faces' }
const { photos, order = 'color' } = Astro.props;
const items = order === 'manual' ? photos : order === 'life' ? sortLife(photos) : order === 'faces' ? sortFaces(photos) : sortByColor(photos);
// ancho real de cada versión: -400 tiene 400 px de ancho; -800 cabe en 800×800
const w800 = (p: Photo) => (p.ratio >= 1 ? 800 : Math.round(800 * p.ratio));
const srcset = (p: Photo) => `/photos/${p.id}-400.webp 400w, /photos/${p.id}-800.webp ${w800(p)}w`;
// hueco que ocupa cada foto según las columnas de la web (5/4/3/2); las horizontales, el doble
const SIZES_V = '(min-width: 1500px) 20vw, (min-width: 900px) 25vw, (min-width: 560px) 33vw, 50vw';
const SIZES_W = '(min-width: 1500px) 40vw, (min-width: 900px) 50vw, (min-width: 560px) 66vw, 100vw';
---
<noscript><style>.grid figure { display: block !important; position: static !important; } .grid figure img { opacity: 1 !important; }</style></noscript>
<div class="grid">
  {items.map((p, i) => (
    <figure class={p.ratio > 1.15 ? 'wide' : undefined} data-id={p.id} data-r={p.ratio} data-title={p.title}>
      {/* las primeras fotos (lo que se ve al entrar) se piden enseguida; el resto, al acercarse */}
      <img src={`/photos/${p.id}-800.webp`} srcset={srcset(p)} sizes={p.ratio > 1.15 ? SIZES_W : SIZES_V} alt={p.title ?? ''} loading={i < 8 ? 'eager' : 'lazy'} fetchpriority={i < 3 ? 'high' : undefined} decoding="async" width="800" height={Math.round(800 / p.ratio)} />
      {p.title && <figcaption class={(p.lumB ?? p.lum) < 0.45 ? 'light' : undefined}>{p.title}</figcaption>}
    </figure>
  ))}
</div>

<style>
  /* Mosaico compacto (JS, src/lib/mosaic-layout.js): cada foto conserva su proporción, las verticales tienen el alto de una de 35 mm, las horizontales ocupan dos columnas y no quedan huecos. */
  .grid { position: relative; }
  /* Hasta que el mosaico coloca las fotos, no se muestran: así el navegador no descarga todas de golpe
     (creería que están a la vista) y la página no salta al colocarlas. El pie queda abajo mientras tanto. */
  .grid:not(.ready) { min-height: 100vh; }
  .grid:not(.ready) figure { display: none; }
  figure { position: absolute; margin: 0; cursor: zoom-in; }
  figure img { display: block; width: 100%; height: auto; box-sizing: border-box; padding: 6px; background: var(--mat); opacity: 0; transition: opacity 0.5s; }
  figure img.ok { opacity: 1; }
  /* Texto de la foto: discreto, en gris, en la parte inferior; aparece al pasar el cursor */
  figcaption { position: absolute; left: 6px; right: 6px; bottom: 6px; padding: 0.45rem 0.6rem 0.78rem; font-size: 0.7rem; letter-spacing: 0.04em; text-align: center; color: rgba(15, 15, 15, 0.92); opacity: 0; transition: opacity 0.35s; pointer-events: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  figcaption.light { color: rgba(255, 255, 255, 0.96); }
  figure:hover figcaption { opacity: 1; }
  @media (hover: none) { figcaption { display: none; } }
</style>

<script>
  import { packMosaic, readingOrder } from '../lib/mosaic-layout.js';
  const GAP = 10, PAD = 12; // hueco entre fotos y marco (6px por lado)
  const colCount = () => (innerWidth >= 1500 ? 5 : innerWidth >= 900 ? 4 : innerWidth >= 560 ? 3 : 2);

  // Colocación en src/lib/mosaic-layout.js (la misma que usa el editor de orden del catálogo):
  // primera fila alineada arriba, verticales a la altura de una de 35 mm, horizontales a dos columnas, sin huecos.
  // orden en que se ven las fotos (de izquierda a derecha y hacia abajo): lo sigue el visor al pasar de una a otra
  const lectura = new Map<HTMLElement, HTMLElement[]>();
  function layout(grid: HTMLElement) {
    const figs = [...grid.querySelectorAll('figure')] as HTMLElement[];
    const ratios = figs.map((el) => +el.dataset.r!);
    const { pos, height } = packMosaic(ratios, grid.clientWidth, colCount(), { gap: GAP, pad: PAD });
    figs.forEach((el, i) => { const p = pos[i]; el.style.cssText = `left:${p.x}px;top:${p.y}px;width:${p.w}px`; });
    grid.style.height = `${Math.ceil(height)}px`;
    lectura.set(grid, readingOrder(pos, ratios, { pad: PAD }).map((i) => figs[i]));
  }

  const grids = [...document.querySelectorAll<HTMLElement>('.grid')];
  const layoutAll = () => grids.forEach(layout);
  document.querySelectorAll<HTMLImageElement>('.grid img').forEach((img) => {
    const ok = () => img.classList.add('ok');
    img.complete ? ok() : img.addEventListener('load', ok);
  });
  layoutAll();
  grids.forEach((g) => g.classList.add('ready'));
  addEventListener('resize', layoutAll);

  // Visor (uno por página, ver Lightbox.astro): tira de fotos movida con transform. Cada gesto pasa exactamente una foto
  // y siempre en el orden numerado: dedo en móvil (la foto sigue al dedo), dos dedos en el trackpad (una por gesto,
  // aunque haya inercia), flechas, teclado o clic en la mitad derecha/izquierda de la pantalla. No da la vuelta al final.
  // Va en el orden en que se ven las fotos: de izquierda a derecha y hacia abajo (cambia con el ancho de la ventana).
  const lb = document.getElementById('lightbox');
  if (lb) {
    const track = document.getElementById('lb-track')!;
    const rail = document.createElement('div'); rail.id = 'lb-rail'; track.appendChild(rail);
    const lbTitle = lb.querySelector('p')!;
    const prevBtn = document.getElementById('lb-prev')!, nextBtn = document.getElementById('lb-next')!;
    const touch = matchMedia('(hover: none)').matches;
    // una "diapositiva" por foto, en el orden en que se ven; la imagen se carga cuando está cerca (y no se vuelve a pedir)
    let all: HTMLElement[] = [], slides: HTMLElement[] = [];
    const slideDe = new Map<HTMLElement, HTMLElement>();
    const montar = () => {
      all = grids.flatMap((g) => lectura.get(g) || []);
      slides = all.map((fig) => {
        let d = slideDe.get(fig);
        if (!d) {
          d = document.createElement('div'); d.className = 'slide';
          const img = document.createElement('img'); img.alt = fig.dataset.title || ''; img.dataset.src = `/photos/${fig.dataset.id}-1600.webp`; img.draggable = false;
          d.appendChild(img); slideDe.set(fig, d);
        }
        return d;
      });
      rail.replaceChildren(...slides);
    };
    let idx = 0, noClickUntil = 0;
    const load = (i: number) => { for (const k of [i - 1, i, i + 1, i + 2]) { const img = slides[k]?.querySelector('img'); if (img && !img.src) img.src = img.dataset.src!; } };
    const place = (anim: boolean, extra = 0) => { rail.style.transition = anim ? '' : 'none'; rail.style.transform = `translate3d(${-idx * track.clientWidth + extra}px,0,0)`; };
    const goTo = (i: number, anim = true) => {
      i = Math.max(0, Math.min(all.length - 1, i));
      idx = i; load(i);
      lbTitle.textContent = all[i].dataset.title || '';
      prevBtn.hidden = i === 0; nextBtn.hidden = i === all.length - 1;
      place(anim);
    };
    const step = (d: number) => goTo(idx + d);
    const open = (fig: HTMLElement) => { montar(); lb.hidden = false; goTo(all.indexOf(fig), false); };
    const closeLb = () => { lb.hidden = true; };
    // al cambiar el ancho puede cambiar el número de columnas y con él el orden en que se ven
    addEventListener('resize', () => { if (lb.hidden) return; const f = all[idx]; montar(); idx = Math.max(0, all.indexOf(f)); place(false); });
    document.addEventListener('click', (e) => {
      const fig = (e.target as HTMLElement).closest('.grid figure') as HTMLElement | null;
      if (fig) open(fig);
    });
    lb.addEventListener('click', (e) => {
      if (Date.now() < noClickUntil) return;   // el clic que llega al terminar un arrastre no cuenta
      const t = e.target as HTMLElement;
      // clic en la foto: mitad derecha de la pantalla = siguiente, izquierda = anterior
      if (t.tagName === 'IMG') { if (touch) return; step(e.clientX > innerWidth / 2 ? 1 : -1); }
      else if (t.id === 'lb-next') step(1);
      else if (t.id === 'lb-prev') step(-1);
      else closeLb();
    });
    addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') closeLb(); else if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); step(1); } else if (e.key === 'ArrowLeft') step(-1);
    });

    // Trackpad (dos dedos): una foto por gesto. La inercia del trackpad sigue enviando movimiento un rato después
    // de levantar los dedos: se ignora hasta que para, salvo que empiece claramente un gesto nuevo.
    let acc = 0, bloqueado = false, bloqueadoEn = 0, ultimo = 0, fin = 0;
    lb.addEventListener('wheel', (e) => {
      e.preventDefault();
      const dx = Math.abs(e.deltaX) >= Math.abs(e.deltaY) ? e.deltaX : 0, a = Math.abs(dx), ahora = performance.now();
      clearTimeout(fin); fin = window.setTimeout(() => { bloqueado = false; acc = 0; ultimo = 0; }, 160);
      if (bloqueado && ahora - bloqueadoEn > 280 && a > 6 && a > ultimo * 1.8) { bloqueado = false; acc = 0; }   // gesto nuevo sobre la inercia
      ultimo = a;
      if (bloqueado || !dx) return;
      acc += dx;
      if (Math.abs(acc) > 30) { step(acc > 0 ? 1 : -1); bloqueado = true; bloqueadoEn = ahora; acc = 0; }
    }, { passive: false });

    // Dedo (móvil): la foto sigue al dedo; al soltar pasa a la siguiente/anterior si se ha deslizado lo suficiente
    let x0 = 0, y0 = 0, t0 = 0, dxT = 0, eje = '', arrastrando = false;
    track.addEventListener('touchstart', (e) => { if (e.touches.length !== 1) return; const t = e.touches[0]; x0 = t.clientX; y0 = t.clientY; t0 = performance.now(); dxT = 0; eje = ''; arrastrando = true; }, { passive: true });
    track.addEventListener('touchmove', (e) => {
      if (!arrastrando || e.touches.length !== 1) return;
      const t = e.touches[0], ddx = t.clientX - x0, ddy = t.clientY - y0;
      if (!eje && Math.abs(ddx) + Math.abs(ddy) > 8) eje = Math.abs(ddx) > Math.abs(ddy) ? 'x' : 'y';
      if (eje !== 'x') return;
      e.preventDefault();
      dxT = (idx === 0 && ddx > 0) || (idx === all.length - 1 && ddx < 0) ? ddx * 0.3 : ddx;   // resistencia en los extremos
      place(false, dxT);
    }, { passive: false });
    const soltar = () => {
      if (!arrastrando) return; arrastrando = false;
      if (eje !== 'x') return;
      noClickUntil = Date.now() + 350;
      const v = Math.abs(dxT) / Math.max(1, performance.now() - t0);
      if (Math.abs(dxT) > track.clientWidth * 0.18 || (v > 0.3 && Math.abs(dxT) > 20)) step(dxT < 0 ? 1 : -1); else place(true);
    };
    track.addEventListener('touchend', soltar); track.addEventListener('touchcancel', soltar);
  }
</script>
