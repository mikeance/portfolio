---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';
import '../styles/global.css';
interface Props { lang: Lang; path: string; title?: string }
const { lang, path, title } = Astro.props;
const t = useTranslations(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title ? `${title} · ${site.name}` : `${site.name} · Photography`}</title>
    <meta name="description" content={t('site.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ? `${title} · ${site.name}` : `${site.name} · Photography`} />
    <meta property="og:description" content={t('site.description')} />
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://mikeance.com').href} />
    <meta property="og:image" content="https://mikeance.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://mikeance.com/og.png" />
  </head>
  <body>
    <Header lang={lang} current={path} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
