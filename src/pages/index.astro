---
import MosaicPage from '../views/MosaicPage.astro';
import { photos, homeMix, sortLife, spreadSessions } from '../lib/photos';
// Portada: las fotos elegidas en el editor (fotos/portada) ordenadas con la estética de Life y sin sesiones
// pegadas; si no hay ninguna, lo mejor de cada categoría (~240).
const home = photos.filter((p) => p.cat === 'home');
---
<MosaicPage lang="es" path="/" photos={home.length ? spreadSessions(sortLife(home)) : homeMix(photos)} order="manual" />
