---
import MosaicPage from '../views/MosaicPage.astro';
import { photos, homeMix, sortLife, spreadSessions, jitter } from '../lib/photos';
import { useTranslations } from '../i18n/ui';
const t = useTranslations('en');
// Portada: las fotos y el ORDEN del editor de portada (fotos/portada); si no hay ninguna, lo mejor de cada categoría (~240).

const home = photos.filter((p) => p.cat === 'home');
---
<MosaicPage lang="en" path="/" h1={t('seo.home.h1')} photos={home.length ? home : homeMix(photos)} order="manual" />
