---
import MosaicPage from '../../views/MosaicPage.astro';
import { photos, categories, sortLife, sortFaces, sortByColor } from '../../lib/photos';
import { useTranslations } from '../../i18n/ui';
export function getStaticPaths() { return categories.map((cat) => ({ params: { cat } })); }
const { cat } = Astro.params;
const t = useTranslations('en');
const list = photos.filter((p) => p.cat === cat);
// Orden: el fijado a mano en el catálogo (ord) si existe; el resto, con el criterio automático de la categoría.
const auto = (l: typeof list) => (cat === 'lifestyle' ? sortLife(l) : cat === 'faces' ? sortFaces(l) : sortByColor(l));
const manual = list.filter((p) => p.ord !== undefined).sort((a, b) => a.ord! - b.ord!);
const items = manual.length ? [...manual, ...auto(list.filter((p) => p.ord === undefined))] : auto(list);
---
<MosaicPage lang="en" path={`/photography/${cat}`} title={t(`seo.${cat}.title` as any)} description={t(`seo.${cat}.description` as any)} h1={`${t(`seo.${cat}.title` as any)} — Miguel Antón`} photos={items} order="manual" share />
