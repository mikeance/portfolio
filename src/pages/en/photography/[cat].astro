---
import MosaicPage from '../../../views/MosaicPage.astro';
import { photos, categories } from '../../../lib/photos';
import { useTranslations } from '../../../i18n/ui';
export function getStaticPaths() { return categories.map((cat) => ({ params: { cat } })); }
const { cat } = Astro.params;
const t = useTranslations('en');
---
<MosaicPage lang="en" path={`/photography/${cat}`} title={t(`cat.${cat}` as any)} photos={photos.filter((p) => p.cat === cat)} order={cat === 'lifestyle' ? 'life' : cat === 'faces' ? 'faces' : 'color'} />
