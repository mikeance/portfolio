{
  // Web estática servida como assets de un Worker (Cloudflare). Publicar: npm run deploy
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "routes": [
    { "pattern": "mikeance.com", "custom_domain": true },
    { "pattern": "www.mikeance.com", "custom_domain": true },
    { "pattern": "miguelanton.me", "custom_domain": true },
    { "pattern": "www.miguelanton.me", "custom_domain": true }
  ]
}
